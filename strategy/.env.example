# --- Perpl (perps venue) ---
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143
PERPL_RPC_URL=https://testnet-rpc.monad.xyz
PERPL_EXCHANGE_ADDRESS=0x1964c32f0be608e7d29302aff5e61268e72080cc
PERPL_COLLATERAL_TOKEN=0xdf5b718d8fcc173335185a2a1513ee8151e3c027
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# --- Kuru (on-chain CLOB venue, Monad testnet) ---
# testnet-rpc.monad.xyz may be DNS-blocked in some networks; point this at a
# provider RPC (e.g. a QuikNode Monad-testnet endpoint) if the public one fails.
KURU_RPC_URL=https://testnet-rpc.monad.xyz
# Flux-owned Kuru MON/Circle-USDC market deployed for this vault.
KURU_MARKET_ADDRESS=0x9aaf57ae35Be175afB906dc4290FD5a1F6eA7897
# Circle's canonical Monad testnet USDC, used as both the vault asset and market quote.
KURU_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
# MarginAccount contract that holds Kuru maker balances.
KURU_MARGIN_ACCOUNT=0xd029C2D98ff85D8F64799017fE00a59B1159CE02

# --- Flux vault owner / keeper signer ---
# Keep the private key only in your local ignored strategy/.env file.
VAULT_OWNER_PRIVATE_KEY=

# --- Flux strategy vault (Kuru custody path) ---
# Deployed on Monad testnet. The vault asset matches Kuru's quote token above.
FLUX_STRATEGY_VAULT_ADDRESS=0x67f5787E44A42BBb12fdA9A3a9142Bd6cEEffb42
KURU_STRATEGY_ADDRESS=0x1AC5d862e48001b139070F9A64F9dd164B6A6d1B
# Block containing KuruMarginStrategy deployment; required to recover resting orders after restart.
KURU_ORDER_SCAN_START_BLOCK=70802965
# Stork's Monad Testnet receiver and encoded MON/USD + USDC/USD feed IDs.
STORK_ORACLE_ADDRESS=0xacC0a0cF13571d30B4b8637996F5D6D774d4fd62
STORK_BASE_USD_FEED_ID=0xa4f6b07ae0c89e3f3cc03c1badcc3e9adffdf7206bafcd56d142979800887385
STORK_QUOTE_USD_FEED_ID=0x7416a56f222e196d0487dce8a1a8003936862e7a15092a91898d69fa8bce290c
KURU_KEEPER_ADDRESS=0x0B674517Df23F2A1631A06D6E48C21f10dcbC144
FLUX_STRATEGY_ASSET_CAP=1000000000
FLUX_MAX_VALUATION_AGE=3600
KURU_MAX_ORACLE_AGE=3600
KURU_MAX_ORDER_DEVIATION_BPS=500
KURU_EMERGENCY_SLIPPAGE_BPS=300
# Monad testnet only: allows the Kuru venue minimum with about $11 of vault NAV.
# Each resting side is still limited by the actual available vault/strategy balance.
FLUX_MAX_ORDER_NOTIONAL_FRACTION=0.5

# The contracts are deployed and the strategy is registered. Do not start the
# runner or allocate funds until the Kuru lifecycle preflight and manual review pass.
# Foundry reads process environment (this installed version has no --dotenv flag); in PowerShell:
# $env:VAULT_OWNER_PRIVATE_KEY = (Get-Content strategy/.env | Where-Object { $_ -match '^VAULT_OWNER_PRIVATE_KEY=' } | ForEach-Object { $_.Split('=', 2)[1] })
# forge script script/DeployFluxKuru.s.sol:DeployFluxKuruScript --rpc-url https://testnet-rpc.monad.xyz --broadcast
