# Flux frontend — environment
# Copy to `.env.local` for local development. All vars are public (NEXT_PUBLIC_*):
# they ship to the browser, so never put secrets here.

# WalletConnect Cloud project id. Injected wallets (MetaMask, Rabby) work without
# a real id, but the WalletConnect QR / mobile flow needs one from
# https://cloud.walletconnect.com. A fallback string is used if this is unset.
NEXT_PUBLIC_WC_PROJECT_ID=

# Monad testnet RPC. Defaults to https://testnet-rpc.monad.xyz if unset. Point at
# your own provider (e.g. a QuikNode endpoint) for higher rate limits.
NEXT_PUBLIC_MONAD_RPC=

# Optional override for the vault and its asset. Keep both addresses paired.
# The default is FluxStrategyVault + Circle testnet USDC, which also quotes the Kuru market.
# The strategy vault's deposit button remains disabled in the app until the full
# Kuru trade/unwind cycle is verified.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_VAULT_ASSET_ADDRESS=

# Aurora/NEAR Intents deposit rail (server-side only — never NEXT_PUBLIC_*).
# Partner API key for the 1Click Swap API (X-API-Key). Without it, the
# any-chain deposit flow returns 503 with a setup hint.
INTENTS_API_KEY=
# Optional override for the Intents API base (e.g. Aurora's endpoint).
INTENTS_API_BASE=
# Optional integrator fee: recipient Intents account + basis points, added to
# every quote as appFees (the integrator revenue share).
INTENTS_FEE_RECIPIENT=
INTENTS_FEE_BPS=
