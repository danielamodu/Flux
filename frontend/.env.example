# Flux frontend — environment
# Copy to `.env.local` for local development. All vars are public (NEXT_PUBLIC_*):
# they ship to the browser, so never put secrets here.

# WalletConnect Cloud project id. Injected wallets (MetaMask, Rabby) work without
# a real id, but the WalletConnect QR / mobile flow needs one from
# https://cloud.walletconnect.com. A fallback string is used if this is unset.
NEXT_PUBLIC_WC_PROJECT_ID=

# Monad testnet RPC. Defaults to https://testnet-rpc.monad.xyz if unset. Point at
# your own provider (e.g. a QuikNode endpoint) for higher rate limits.
NEXT_PUBLIC_MONAD_RPC=

# Optional override for the deployed custody-based FluxVault address.
# The app defaults to the current deployment when this is blank.
NEXT_PUBLIC_VAULT_ADDRESS=
